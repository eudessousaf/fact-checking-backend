# Copie para .env e preencha. O .env NUNCA vai para o Git (.gitignore).

# --- Painel do operador (só localhost) ---
PANEL_PASSWORD=
PANEL_HOST=127.0.0.1
PANEL_PORT=8765

# --- Onde ficam áudio, banco SQLite e arquivos gerados ---
DATA_DIR=./data

# --- Configuração do debate (nomes, horário). Copie config/debate.example.toml ---
DEBATE_CONFIG=./config/debate.toml

# --- Ambiente de publicação: teste | producao ---
ENVIRONMENT=teste

# --- Captura de áudio (etapa 2) ---
# Vazio = monitor da saída de som padrão. Liste as opções com:
#   factcheck capture --list-sources
CAPTURE_SOURCE=
CHUNK_SECONDS=30
CHUNK_OVERLAP_SECONDS=2
SILENCE_ALERT_SECONDS=20
SILENCE_THRESHOLD_DBFS=-50

# --- Chaves de API (preenchidas nas etapas 3 e 6/7) ---
ANTHROPIC_API_KEY=
# Transcrição (etapa 3): OpenAI, modelo com separação de falantes por voz.
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
TRANSCRIPTION_LANGUAGE=pt
# Preço por milhão de tokens (confira no painel de uso da OpenAI)
TRANSCRIPTION_USD_PER_M_INPUT=2.50
TRANSCRIPTION_USD_PER_M_OUTPUT=10.00

# --- Claude (detecção e verificação) ---
DETECT_MODEL=claude-haiku-5-5
VERIFY_MODEL=claude-sonnet-5-5
VERIFY_EFFORT=high
VERIFY_WORKERS=2
HAIKU_USD_PER_M_INPUT=0.10
HAIKU_USD_PER_M_OUTPUT=0.50
SONNET_USD_PER_M_INPUT=2.00
SONNET_USD_PER_M_OUTPUT=10.00
WEB_SEARCH_USD_PER_1000=10.00

# --- Hospedagem: DigitalOcean Spaces (etapa 9) ---
SPACES_BUCKET=
SPACES_REGION=
SPACES_KEY=
SPACES_SECRET=
# Vazio = "teste" quando ENVIRONMENT=teste, raiz do bucket em produção.
SPACES_PREFIX=

# --- Orçamento (US$) ---
BUDGET_WARN_USD=80
BUDGET_HARD_STOP_USD=100
